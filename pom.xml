<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.graphrd</groupId>
  <artifactId>graphrd-client</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>GraphRD Java client</name>
  <description>The pure-Java client of GraphRD: SPARQL, RDF statements, repository
    management, and a JPA-shaped object mapper with zero dependencies.</description>
  <url>https://github.com/halilugur/graphrd-client</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>halilugur</id>
      <name>Halil Ugur</name>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/halilugur/graphrd-client.git</connection>
    <developerConnection>scm:git:git@github.com:halilugur/graphrd-client.git</developerConnection>
    <url>https://github.com/halilugur/graphrd-client</url>
  </scm>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- the server the self-hosted tests boot; override with -Dgraphrd.bin=... -->
    <graphrd.bin>${project.basedir}/../../target/release/graphrd</graphrd.bin>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <systemPropertyVariables>
            <graphrd.bin>${graphrd.bin}</graphrd.bin>
          </systemPropertyVariables>
          <includes>
            <include>**/*IT.java</include>
            <include>**/*Test.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
